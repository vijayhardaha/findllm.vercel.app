{
  "name": "llm-finder",
  "version": "1.0.0",
  "description": "LLM Finder is a searchable directory of AI language models. Compare models from OpenAI, Anthropic, Google, Meta, Mistral, DeepSeek, xAI, and more — filtering by pricing, context window, reasoning capabilities, tool support, multimodal input/output, and free availability.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "prepare": "husky"
  },
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha/"
  },
  "license": "MIT",
  "homepage": "https://github.com/vijayhardaha/findllm.vercel.app.git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayhardaha/findllm.vercel.app.git"
  },
  "bugs": {
    "url": "https://github.com/vijayhardaha/findllm.vercel.app/issues"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vijayhardaha/dev-config": "^2.1.1",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "next-sitemap": "^4.2.3",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
